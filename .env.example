# ⚠️ WARNING: DO NOT commit .env file with actual API keys!
# This is an example file. Copy it to .env and fill in your values.
# The .env file is in .gitignore and will not be committed.

# ============================================
# Amazon Bedrock Configuration
# ============================================
AWS_ACCESS_KEY_ID=your_aws_access_key_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_key_here
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=us.anthropic.claude-3-7-sonnet-20250219-v1:0

# ============================================
# Brave Search API Configuration
# ============================================
BRAVE_SEARCH_API_KEY=your_brave_search_api_key_here

# ============================================
# Application Configuration
# ============================================
APP_PORT=8000
LOG_LEVEL=INFO

# ============================================
# AWS Configuration (for ECS deployment)
# ============================================
AWS_ACCOUNT_ID=your_aws_account_id
ECR_REPOSITORY_PREFIX=ai-agent-comparison

# ============================================
# ECS Configuration
# ============================================
ECS_CLUSTER_NAME=ai-agent-cluster
ECS_SERVICE_NAME_LANGGRAPH=langgraph-service
ECS_SERVICE_NAME_CREWAI=crewai-service
ECS_SERVICE_NAME_STRANDS=strands-service
